{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "Traverse",
     "version": "dev",
     "informationUri": "https://github.com/oskillarrr/traverse",
     "rules": [
      {
       "id": "JAVA-LOG4J1",
       "name": "JavaLog4j1",
       "shortDescription": {
        "text": "Log4j 1.x (end of life, CVEs)"
       },
       "fullDescription": {
        "text": "End of life since 2015 with unpatched vulnerabilities (e.g. CVE-2019-17571)."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "Logging",
        "confidence": "high",
        "tags": [
         "Logging"
        ],
        "technology": "Log4j 1.x"
       }
      },
      {
       "id": "RUNTIME-LEVEL",
       "name": "RuntimeLevel",
       "shortDescription": {
        "text": "Outdated runtime level: java 1.6"
       },
       "fullDescription": {
        "text": "Java 6 or older: no supported JDK can target it; upgrade path needed. (count = modules)"
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "Migration",
        "confidence": "high",
        "tags": [
         "Migration"
        ],
        "technology": "java 1.6"
       }
      },
      {
       "id": "SEC-SECRET-CODE",
       "name": "SecSecretCode",
       "shortDescription": {
        "text": "Possible hard-coded credential in code"
       },
       "fullDescription": {
        "text": "Value is never copied to the report."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "Security",
        "confidence": "low",
        "tags": [
         "Security"
        ],
        "technology": "Secrets"
       }
      },
      {
       "id": "JAVA-COMMONS-HTTPCLIENT3",
       "name": "JavaCommonsHttpclient3",
       "shortDescription": {
        "text": "Commons HttpClient 3.x (end of life)"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "Integration",
        "confidence": "medium",
        "tags": [
         "Integration"
        ],
        "technology": "HttpClient 3"
       }
      },
      {
       "id": "JAVA-JAVAX-EE",
       "name": "JavaJavaxEe",
       "shortDescription": {
        "text": "javax.* Java EE namespace (pre Jakarta EE 9)"
       },
       "fullDescription": {
        "text": "Requires the javax→jakarta namespace migration for Jakarta EE 9+ runtimes."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "Migration",
        "confidence": "high",
        "tags": [
         "Migration"
        ],
        "technology": "Java EE (javax)"
       }
      },
      {
       "id": "JAVA-JBOSS-API",
       "name": "JavaJbossApi",
       "shortDescription": {
        "text": "JBoss / WildFly proprietary API"
       },
       "fullDescription": {
        "text": "Couples the application to the JBoss/WildFly runtime."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "Platform",
        "confidence": "medium",
        "tags": [
         "Platform"
        ],
        "technology": "JBoss/WildFly"
       }
      },
      {
       "id": "OPS-INSECURE-REPO",
       "name": "OpsInsecureRepo",
       "shortDescription": {
        "text": "Artifact repository over plain HTTP"
       },
       "fullDescription": {
        "text": "Dependencies downloaded without TLS can be tampered with."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "Security",
        "confidence": "medium",
        "tags": [
         "Security"
        ],
        "technology": "Build"
       }
      },
      {
       "id": "SQL-UTL-NETWORK",
       "name": "SqlUtlNetwork",
       "shortDescription": {
        "text": "Database-initiated network/file access"
       },
       "fullDescription": {
        "text": "The database itself integrates with external systems."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "Integration",
        "confidence": "medium",
        "tags": [
         "Integration"
        ],
        "technology": "DB network"
       }
      },
      {
       "id": "OPS-VENDORED-LIBS",
       "name": "OpsVendoredLibs",
       "shortDescription": {
        "text": "Libraries committed to the repository"
       },
       "fullDescription": {
        "text": "Dependencies without a manager: versions and CVEs are hard to track."
       },
       "defaultConfiguration": {
        "level": "note"
       },
       "properties": {
        "category": "Delivery",
        "confidence": "medium",
        "tags": [
         "Delivery"
        ],
        "technology": "Vendored libraries"
       }
      },
      {
       "id": "SQL-ORACLE-DIALECT",
       "name": "SqlOracleDialect",
       "shortDescription": {
        "text": "Oracle-specific SQL"
       },
       "fullDescription": {
        "text": "Proprietary SQL hinders database portability."
       },
       "defaultConfiguration": {
        "level": "note"
       },
       "properties": {
        "category": "Database",
        "confidence": "medium",
        "tags": [
         "Database"
        ],
        "technology": "Oracle SQL"
       }
      },
      {
       "id": "VULN/TRAVERSEDEMO-2026-0001",
       "name": "KnownVulnerability",
       "shortDescription": {
        "text": "SYNTHETIC DEMO ADVISORY - not real vulnerability data. Remote code execution through a deserialization gadget"
