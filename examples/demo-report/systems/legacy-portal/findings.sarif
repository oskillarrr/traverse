{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "Traverse",
     "version": "dev",
     "informationUri": "https://github.com/oskillarrr/traverse",
     "rules": [
      {
       "id": "NET-WEBFORMS",
       "name": "NetWebforms",
       "shortDescription": {
        "text": "ASP.NET Web Forms"
       },
       "fullDescription": {
        "text": "Not supported on .NET Core / .NET 5+."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "Web",
        "confidence": "medium",
        "tags": [
         "Web"
        ],
        "technology": "Web Forms"
       }
      },
      {
       "id": "NET-FRAMEWORK",
       "name": "NetFramework",
       "shortDescription": {
        "text": ".NET Framework (Windows only)"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "Platform",
        "confidence": "high",
        "tags": [
         "Platform"
        ],
        "technology": ".NET Framework"
       }
      },
      {
       "id": "NET-WCF",
       "name": "NetWcf",
       "shortDescription": {
        "text": "WCF services"
       },
       "fullDescription": {
        "text": "WCF server is not available on modern .NET (CoreWCF required)."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "Integration",
        "confidence": "medium",
        "tags": [
         "Integration"
        ],
        "technology": "WCF"
       }
      },
      {
       "id": "RUNTIME-LEVEL",
       "name": "RuntimeLevel",
       "shortDescription": {
        "text": "Outdated runtime level: .NET v4.5"
       },
       "fullDescription": {
        "text": ".NET Framework is Windows-only; modern .NET requires migration. (count = modules)"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "Migration",
        "confidence": "high",
        "tags": [
         "Migration"
        ],
        "technology": ".NET v4.5"
       }
      },
      {
       "id": "VULN/TRAVERSEDEMO-2026-0003",
       "name": "KnownVulnerability",
       "shortDescription": {
        "text": "SYNTHETIC DEMO ADVISORY - not real vulnerability data. XML external entity processing in configuration loader"
       },
       "helpUri": "https://osv.dev/vulnerability/TRAVERSEDEMO-2026-0003",
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "aliases": null,
        "category": "vulnerability",
        "confidence": "low",
        "source": "OSV.dev",
        "tags": [
         "security",
         "vulnerability"
        ]
       }
      }
     ]
    }
   },
   "automationDetails": {
    "id": "traverse/legacy-portal/"
   },
   "results": [
    {
     "ruleId": "NET-WEBFORMS",
     "ruleIndex": 0,
     "level": "error",
     "message": {
      "text": "ASP.NET Web Forms. Not supported on .NET Core / .NET 5+."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "Portal/Default.aspx.cs",
         "uriBaseId": "SRCROOT"
        },
        "region": {
         "startLine": 1
        }
       }
      }
     ],
     "partialFingerprints": {
